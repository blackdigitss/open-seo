{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The fork's scheduled Worker (src/custom/worker.ts). It binds the SAME D1,
  // KV and R2 the app's alchemy deploy created for the "selfhost" stage, so
  // the resource ids below must match those — `node scripts/custom/worker-config.mjs`
  // resolves them from the Cloudflare API and rewrites this file.
  //
  // Deploy and secrets: see docs/FORK_DEPLOY.md
  "name": "open-seo-custom",
  "main": "src/custom/worker.ts",
  "workers_dev": true,
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Upstream services we call (GSC, project context, audits) transitively pull
  // in @tanstack/start-server-core, whose dynamic router/start entry imports
  // only exist in a TanStack Start build. This worker has no router and never
  // reaches them — alias them to a stub that throws if that ever changes.
  "alias": {
    "#tanstack-router-entry": "./src/custom/tanstack-entry-stub.ts",
    "#tanstack-start-entry": "./src/custom/tanstack-entry-stub.ts",
    "tanstack-start-manifest:v": "./src/custom/tanstack-entry-stub.ts",
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "vars": {
    "AUTH_MODE": "cloudflare_access",
    "DATABASE_PROVIDER": "d1",
    "VAPID_SUBJECT": "mailto:davainwalker1@gmail.com",
    "CUSTOM_APP_URL": "https://open-seo-selfhost.davainwalker.workers.dev",
  },
  "ai": {
    "binding": "AI",
  },
  // Placeholder ids below are overwritten by scripts/custom/worker-config.mjs.
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "00000000000000000000000000000000",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-seo-selfhost",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/custom",
      "migrations_table": "d1_custom_migrations",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "open-seo-selfhost",
      "binding": "R2",
    },
  ],
}
