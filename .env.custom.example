# Secrets and vars for the fork's scheduled Worker (open-seo-custom).
# `pnpm custom:secrets` pushes these plus the shared ones from .env.selfhost
# (DATAFORSEO_API_KEY, GOOGLE_CLIENT_ID/SECRET, BETTER_AUTH_SECRET,
# OPENROUTER_API_KEY) to the Worker. This file is gitignored.

# Web Push — generate with: node scripts/custom/vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_JWK=

# Email through Loops (https://app.loops.so → Settings → API). The template is
# created automatically on first send; set the id only to use your own.
LOOPS_API_KEY=
# LOOPS_TRANSACTIONAL_BRIEFING_ID=

# iMessage through a running BlueBubbles server (optional).
# BLUEBUBBLES_URL=https://your-tunnel.trycloudflare.com
# BLUEBUBBLES_PASSWORD=

# Shared secret for POST /run?job=<name> on the custom Worker.
CUSTOM_RUN_SECRET=

# LLM for drafts. OpenRouter when OPENROUTER_API_KEY is set in .env.selfhost;
# otherwise Workers AI through the Worker's AI binding.
# CUSTOM_LLM_MODEL=anthropic/claude-sonnet-4.5
# CUSTOM_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
